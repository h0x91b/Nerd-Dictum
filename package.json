{
  "name": "nerd-dictum",
  "version": "0.7.2",
  "description": "A minimal floating window for voice-to-text transcription using Google Gemini",
  "type": "module",
  "main": "dist/main/main.js",
  "author": {
    "name": "Arseny Pavlenko",
    "email": "ArsenyPavlenko@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "bun run build:main && bun run build:preload && concurrently \"vite\" \"wait-on http://localhost:${VITE_PORT:-12000} && NODE_ENV=development electron .\"",
    "build": "bun run build:main && bun run build:preload && vite build",
    "build:main": "bun build src/main/main.ts --outdir dist/main --target node --external electron",
    "build:preload": "bun build src/preload/preload.ts --outdir dist/preload --target node --external electron --format cjs",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:renderer": "vite",
    "dist": "bun run build && APPLE_KEYCHAIN_PROFILE=AC_PASSWORD electron-builder --mac",
    "dist:unsigned": "bun run build && electron-builder --mac -c.mac.identity=null",
    "dist:win": "bun run build && electron-builder --win",
    "dist:linux": "bun run build && electron-builder --linux",
    "release": "bun run build && APPLE_KEYCHAIN_PROFILE=AC_PASSWORD electron-builder --mac --publish always",
    "bump": "bun run scripts/bump.ts",
    "bump:minor": "bun run scripts/bump.ts minor",
    "bump:major": "bun run scripts/bump.ts major"
  },
  "build": {
    "appId": "com.h0x91b.nerddictum",
    "productName": "Nerd Dictum",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Arseny Pavlenko",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/*.md"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "identity": "Arseny Pavlenko (7972FR33R4)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app needs microphone access to record and transcribe your voice."
      },
      "notarize": true,
      "singleArchFiles": "**/uiohook-napi/**"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "h0x91b",
      "repo": "Nerd-Dictum",
      "private": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.11",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.4.0",
    "happy-dom": "^20.0.11",
    "typescript": "^5.0.0",
    "vite": "^7.3.0",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uiohook-napi": "^1.5.4"
  }
}
